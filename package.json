{
  "name": "@cjboco/cj-image-flip-previewer",
  "version": "1.2.0",
  "description": "React components for interactive image previews - flip through images by mouse position (FlipPreviewer) or animate frames on hover like a video previewer (VideoPreviewer).",
  "author": "Doug Jones",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/cjboco/cj-image-flip-previewer.git"
  },
  "homepage": "https://cjboco.github.io/cj-image-flip-previewer/",
  "bugs": {
    "url": "https://github.com/cjboco/cj-image-flip-previewer/issues"
  },
  "keywords": [
    "react",
    "image",
    "flipbox",
    "video-previewer",
    "360",
    "product-view",
    "interactive",
    "mouseover",
    "hover",
    "thumbnail",
    "animation"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
